{
  "name": "dsh-ai-browser",
  "version": "1.1.0",
  "type": "module",
  "description": "AI 浏览器模式：在会话右侧打开应用内浏览器（多窗口），AI 可读取页面、点击/输入/滚动、截图和下载文件；提供每窗口四级浏览器权限、风险警告、主动授权越权，下载支持断点续传与进度/速度面板。",
  "license": "MIT",
  "author": "Akivelli",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "browser",
    "ai-browser",
    "webview",
    "download"
  ],
  "exports": {
    ".": "./index.js",
    "./preset": "./preset.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "preset.js",
    "lib",
    "client.js",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/745403lkh/dsh-ai-browser.git"
  },
  "homepage": "https://github.com/745403lkh/dsh-ai-browser#readme",
  "bugs": {
    "url": "https://github.com/745403lkh/dsh-ai-browser/issues"
  }
}
